{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "strict": true,
    "skipLibCheck": true,
  },

  "include": [
    "./hardhat.config.ts",
    "./scripts",
    "./test",
    "./typechain-types",
    "node_modules/@nomicfoundation/hardhat-ethers/types",
    "node_modules/@nomicfoundation/hardhat-ethers-chai-matchers/types",
    "node_modules/@nomicfoundation/hardhat-toolbox-mocha-ethers/types"
  ],

  "exclude": ["node_modules"]
}
